						</h1>

						RSS Feed Preview
					</div>
					<div class="padding">
						<h2 class="atom__list-title">Events and code jams</h2>
						<ul class="atom__list">
							<xsl:for-each select="/atom:feed/atom:entry">
								<li class="atom__list-item">
									<div class="atom__list-date small">
                    Published:
										<xsl:value-of select="substring(atom:updated, 0, 11)" />
									</div>
									<a class="atom__list-link">
										<xsl:attribute name="href">
											<xsl:value-of select="atom:link/@href"/>
										</xsl:attribute>
										<xsl:value-of select="atom:title"/>
									</a>
								</li>
							</xsl:for-each>
						</ul>
